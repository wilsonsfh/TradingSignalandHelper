# ─────────────────────────────────────────────────────────────
#  TradingSignalandHelper — configuration
#  Copy this file to `.env` and edit. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

# Broker mode:  mock | moomoo
#   mock   = fake fills, no broker needed (default, safe)
#   moomoo = Moomoo via OpenD; keep TRD_ENV=SIMULATE until verified
BROKER=mock

# Trading environment (only used when BROKER=moomoo): SIMULATE | REAL
#   SIMULATE = paper trading (fake money)
#   REAL     = LIVE money. Double-gated. Keep SIMULATE while learning.
TRD_ENV=SIMULATE

# Price data source: demo | yfinance
#   demo     = offline synthetic data (no network, default)
#   yfinance = real (delayed) market data
# BROKER=moomoo requires yfinance for strategy candles; OpenD supplies live monitor quotes.
DATA_SOURCE=demo

# Watchlist (comma-separated US tickers)
WATCHLIST=AAPL,MSFT,NVDA,SPY

# EMA crossover strategy parameters
EMA_FAST=9
EMA_SLOW=21
CANDLE_PERIOD=6mo
CANDLE_INTERVAL=1d

# Risk / position sizing
QUANTITY=1
TAKE_PROFIT_PCT=3.0
STOP_LOSS_PCT=2.0
# Max quantity an inbound TradingView alert may request (server-side cap)
MAX_ALERT_QUANTITY=100

# Local state and soft-stop polling
STATE_DB_PATH=state/trading.sqlite
SOFT_STOP_POLL_SECONDS=4.0

# moomoo OpenD connection (used only when BROKER=moomoo)
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
# Place a resting broker stop-loss order (entry + limit TP + stop SL, tied as a
# manual OCO, matching the TradingView->moomoo bridge design). When false, the
# stop-loss is monitored in software (soft stop) — the default.
USE_BROKER_STOP_ORDER=false

# ── TradingView webhook (the event-driven signal path) ──
# The alert (Pine script) is the brain: it carries action/side/symbol/quantity/tp/sl.
# Disabled by default and ALWAYS blocked in REAL mode.
WEBHOOK_SECRET=change-me
WEBHOOK_ENABLED=false
WEBHOOK_MAX_AGE_SECONDS=300
# Require an HMAC-SHA256 signature header (X-Signature) as well as the shared key.
WEBHOOK_SIGNATURE_REQUIRED=false
# Comma-separated source IPs allowed to hit /webhook. Empty = no app-level IP check
# (rely on the edge/WAF). TradingView's published webhook IPs (verify before use):
#   52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7
WEBHOOK_IP_ALLOWLIST=
# Per-IP rate limit on /webhook (requests per minute)
WEBHOOK_RATE_PER_MIN=5

# ── Telegram notifications (optional) ──
# Best-effort push on opens, closes, auto-exits (TP/SL/stop), and rejections.
# No-op unless BOTH are set. Create a bot via @BotFather for the token; message the
# bot once and read chat.id from https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local web dashboard
WEB_HOST=127.0.0.1
WEB_PORT=5000
